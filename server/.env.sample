
# Database
MONGO_DB_URL=
# Backward compatibility alias (optional, if used by older docs)
MONGODB_URI=
PORT=5000

# CORS
CORS_ORIGIN1=
CORS_ORIGIN2=
CORS_ORIGIN3=

# Optional one-time bootstrap seed. Keep values outside the repository.
# INITIAL_ADMIN_USERNAME=Superadmin
# INITIAL_ADMIN_PASSWORD=<SET_OUTSIDE_REPOSITORY>
# INITIAL_ADMIN_NAME=Administrator

# Uploads
# Optional. If set, all uploaded files will be stored/read from this directory.
# Recommended in containers: /data/uploads (then mount a volume to it)
UPLOADS_DIR=
